{
  "name": "petproject",
  "version": "1.0.0",
  "description": "",
  "main": "main.ts",
  "scripts": {
    "dev": "dotenv -e .env -- npx tsx main.ts",
    "dev:push": "dotenv -e .env -- prisma db push",
    "dev:reset": "dotenv -e .env -- prisma migrate reset --force",
    "test:push": "dotenv -e .env.test -- prisma db push",
    "test:run": "dotenv -e .env.test -- vitest run",
    "test": "npm run test:push && npm run test:run",
    "workers": "npx concurrently \"dotenv -e .env -- npx tsx workers/notifications.worker.ts\" \"dotenv -e .env -- npx tsx workers/reports.worker.ts\"",
    "workers:test": "npx concurrently \"dotenv -e .env.test -- npx tsx workers/notifications.worker.ts\" \"dotenv -e .env.test -- npx tsx workers/reports.worker.ts\""

  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@prisma/client": "^6.19.2",
    "argon2": "^0.44.0",
    "bullmq": "^5.74.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.2",
    "vitest": "^4.1.2"
  }
}
