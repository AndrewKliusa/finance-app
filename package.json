    "@types/dotenv": "^6.1.1",
    "@types/node": "^25.5.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "fastify-type-provider-zod": "^6.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
